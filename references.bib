@article{Castilla:2025,
title = {Towards a Digital Twin for Surgical Waiting List Management: A Preliminary Analysis and Design Study},
journal = {Procedia Computer Science},
volume = {274},
pages = {433-443},
year = {2025},
note = {22nd International Multidisciplinary Modeling & Simulation Multiconference (I3M 2025)},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2025.12.043},
url = {https://hdl.handle.net/20.500.14965/697e9d964f95b66d0e7b1e52},
author = {Iván Castilla-Rodríguez and Gara Miranda and Carolina Rodríguez-Orihuela and Eduardo Segredo and Alejandro Marrero},
keywords = {Digital Twin, Hospital Management, Simulation, Surgical Waiting List},
abstract = {Publicly funded healthcare systems face increasing pressure from demographic changes, rising demand, and limited resources, threatening their long-term sustainability. This paper explores the potential of Digital Twin (DT) technology to enhance hospital efficiency, with a specific focus on reducing surgical waiting times. Unlike traditional patient-centric applications, this study proposes a DT framework designed to optimise hospital operations. The conceptual model integrates key stakeholders—patients, surgical and anesthesiology services, and admission departments; along with multiple data sources such as electronic medical records and enterprise resource planning systems. A multi-agent system is used to create dynamic digital counterparts of both patients and resources, enabling real-time data synchronisation and predictive analytics. The DT supports decision-making at various stages of the surgical process, addressing inefficiencies in patient prioritisation, referral decisions, pre-anaesthesia scheduling, and surgical planning. Two illustrative use cases demonstrate the DT’s capacity to predict bed availability and optimise bed allocation to minimise patient reallocation. Emphasising the importance of human-in-the-loop systems, the proposed architecture seeks to improve key performance indicators such as waiting times, resource usage, and patient throughput. This work contributes a novel, management-oriented application of DTs in healthcare and offers a promising pathway to more resilient and efficient hospital systems.}
}

